# ==================== APPLICATION ====================
DEBUG=False
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=INFO
APPLICATION_AUTO_RELOAD=true
APPLICATION_UVICORN_WORKERS_COUNT=1

APP_ENV=dev

# ==================== LOGGING ====================
APPLICATION_LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
LOGS_DIR=logs
LOG_RETENTION_DAYS=30
LOG_ROTATION=daily

# ==================== DATABASE ====================
POSTGRES_DATABASE_HOST=localhost
POSTGRES_DATABASE_PORT=5432
POSTGRES_DATABASE_USERNAME=postgres
POSTGRES_DATABASE_PASSWORD=your_postgres_password_here
POSTGRES_DATABASE_NAME=Surgitutor
POSTGRES_DATABASE_ECHO=false

# ==================== JWT & SECURITY (EXISTING) ====================
JWT_SECRET=your_existing_jwt_secret_here
JWT_LIFETIME_SECONDS=172800

# ==================== AUTH SETTINGS (NEW) ====================
# Generate new secure values:
# openssl rand -hex 32
SECRET_KEY=your_generated_secret_key_here
ACCESS_TOKEN_EXPIRE_SECONDS=604800
VERIFICATION_TOKEN_SECRET=your_generated_email_verification_secret_key_here
RESET_PASSWORD_TOKEN_SECRET=your_generated_reset_password_secret_key_here

# ==================== EMAIL CONFIGURATION (NEW) ====================
SMTP_SERVER=smtp.server.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_TLS=true

# ==================== FRONTEND (NEW) ====================
FRONTEND_BASE_URL=http://localhost:3000

# ==================== CORS ====================
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin
